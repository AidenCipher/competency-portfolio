# Copy to .env.local. Never commit real values.

# Public (safe for the browser): Supabase API URL + anon/publishable key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public site origin, used to build validation links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Resend for validation emails. If unset, the UI shows a copyable link.
RESEND_API_KEY=
RESEND_FROM=
